# FAHAD DEV — Server-Side Environment Variables (Configure privately in Render / .env)
# Generate ADMIN_PASSWORD_HASH and SESSION_SECRET locally with:
#   npm run hash-password

PORT=3000
NODE_ENV=production

# Single Authorized Administrator Configuration (REQUIRED)
ADMIN_EMAIL=YOUR_ADMIN_EMAIL
ADMIN_PASSWORD_HASH=YOUR_SECURE_PASSWORD_HASH
SESSION_SECRET=YOUR_RANDOM_SECRET
